#!/bin/sh -e

[ -f @SYSCONFDIR@/mkinitramfs.conf ] && . @SYSCONFDIR@/mkinitramfs.conf
[ "${1}" ] || exit 1

case "${INITFSCOMP}" in
    lz4) compressor="lz4 -d -c" ;;
    cat) compressor="cat --" ;;
    xz) compressor="xzcat --" ;;
    zstd) compressor="zstd -d -c" ;;
    *) compressor="gzip -dc" ;;
esac

$compressor "${1}" | bsdcpio -it
exit 0
