#!/bin/sh -e

CONFIG="@SYSCONFDIR@/mkinitramfs.conf"

msg_error() {
    printf 'ERROR: %s\n' "${1}" >&2
}

[ -f "${CONFIG}" ] || {
    msg_error "config file '${CONFIG}' does not exist."
    exit 1
}

# shellcheck source=@SYSCONFDIR@/mkinitramfs.conf
. "${CONFIG}"

if [ -z "${1}" ]; then
    printf 'Usage: %s <initramfs>\n' "${0##*/}"
    exit 1
fi

[ -f "${1}" ] || {
    msg_error "initramfs '${1}' does not exist."
    exit 1
}

case "${INIT_FS_COMP}" in
    lz4) compressor="lz4 -d -c" ;;
    cat | none) compressor="cat --" ;;
    xz) compressor="xzcat --" ;;
    zstd) compressor="zstd -d -c" ;;
    *) compressor="gzip -dc" ;;
esac

$compressor "${1}" | bsdcpio -it
