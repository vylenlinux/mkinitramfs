#!/bin/sh

# shellcheck disable=SC2317

PATH=/usr/bin

msg_info() {
    [ "$QUIET" = 1 ] && return
    printf ':: %s\n' "$1"
}

msg_error() {
    printf 'ERROR: %s\n' "$1" >&2
}

msg_warning() {
    [ "$QUIET" = 1 ] && return
    printf 'WARNING: %s\n' "$1" >&2
}

add_binary() {
    bin_path=$(command -v "$1")

    if [ -z "$bin_path" ]; then
        msg_warning "missing binary: $1"
        return
    fi

    add_file "$bin_path"

    if [ -L "$bin_path" ]; then
        add_binary "$(readlink -f "$bin_path")"
        return
    fi

    case "$(file -bi "$bin_path")" in
        *application/x-sharedlib* | *application/x-executable* | *application/x-pie-executable*)
            bin_lib=$(ldd "$bin_path" | awk 'NF == 4 && $3 ~ /^\// {
                print $3;
            }')

            for lib in $bin_lib; do
                add_file "$lib"
            done
        ;;
    esac

    unset bin_path bin_lib
}

add_module() {
    modinfo -k "$KERNEL" "$1" >/dev/null 2>&1 || {
        msg_info "missing module: $1"
        return
    }

    mod_name=$(modinfo -k "$KERNEL" -F name "$1" | head -n1)
    mod_path=$(modinfo -k "$KERNEL" -F filename "$1" | head -n1)

    [ -z "$mod_name" ] && return 0
    [ -z "$mod_path" ] && return 0

    if [ -f "$INITDIR/usr/lib/modules/$KERNEL/kernel/${mod_path##*/}" ]; then
        return
    fi

    add_file "$mod_path" "usr/lib/modules/$KERNEL/kernel/${mod_path##*/}"

    modinfo -F firmware -k "$KERNEL" "$mod_name" | while read -r line; do
        [ -f "/usr/lib/firmware/$line" ] || {
            msg_warning "missing firmware for $mod_name: $line"
            break
        }

        add_file "/usr/lib/firmware/$line"
    done

    for i in $(modinfo -F depends -k "$KERNEL" "$mod_name" | tr ',' ' '); do
        add_module "$i"
    done

    unset mod_name mod_path
}

add_file() {
    [ "$1" ] || return
    src="$1"

    case "$src" in
        /*) ;;

        *)
            msg_warning "absolute source path needed: $src"
            return
        ;;
    esac

    [ -f "$src" ] || {
        msg_warning "file not found: $src"
        return
    }

    dest="${src#/}"

    if [ -n "$2" ]; then
        dest="$2"

        case "$dest" in
            /*)
                msg_warning "destination path must without leading '/': $dest"
                unset src dest

                return
            ;;
        esac
    fi

    mode="${3:-$(stat -c %a "$src")}"

    if [ -z "$mode" ]; then
        msg_warning "failed get file mode: $src"
        unset src dest

        return
    fi

    install -Dm"$mode" "$src" "$INITDIR/$dest"
    unset src dest mode
}

add_dir() {
    path="$1"
    mode="${2:-755}"

    if [ -z "$path" ]; then
        return 1
    fi

    case "$path" in
        /*) ;;
        *) return 1 ;;
    esac

    if [ -d "$INITDIR$path" ]; then
        return 0
    fi

    install -dm"$mode" "$INITDIR$path"
    unset path
}

add_symlink() {
    name="$1"
    target="$2"

    [ "$name" ] || return 1

    if [ -z "$target" ]; then
        target=$(readlink -f "$name")

        if [ -z "$target" ]; then
            msg_error "invalid symlink: $name"
            return 1
        fi
    fi

    add_dir "${name%/*}"

    if [ -L "$INITDIR$name" ]; then
        msg_warning "overwriting symlink: $name"
    fi

    ln -sfn "$target" "$INITDIR$name"
}

finalize_modules() {
    [ -d "$INITDIR/usr/lib/modules/$KERNEL/kernel" ] || return

    for file in "/usr/lib/modules/$KERNEL"/modules.*; do
        add_file "$file"
    done

    awk -F'/' '{printf "kernel/%s", $NF;}' "/usr/lib/modules/$KERNEL/modules.order" > "$INITDIR/usr/lib/modules/$KERNEL/modules.order"
    depmod -b "$INITDIR" "$KERNEL"
}

get_hook_path() {
    case $1 in
        */*) [ -f "$1" ] && printf '%s\n' "$1" ;;

        *)
            for i in $(printf '%s\n' "$HOOKDIRS" | tr ':' ' '); do
                if [ -f "$i/$1" ]; then
                    printf '%s\n' "$i/$1"
                    break
                fi
            done
        ;;
    esac
}

run_build_hook() {
    if [ "$HOOKS" ]; then
        for hook in $HOOKS; do
            case " $DONE_HOOK " in
                *" $hook "*) continue ;;
            esac

            hook_path=$(get_hook_path "$hook.hook") || {
                msg_warning "missing hook: $hook"
                continue
            }

            # shellcheck source=$hook_path
            . "$hook_path"

            if command -v build_hook >/dev/null 2>&1; then
                msg_info "running build_hook: $hook"
                build_hook
            fi

            printf '%s\n' "$hook" >> "$INITDIR/hook/hook.order"
            add_file "$hook_path" "hook/$hook" 755

            DONE_HOOK="$DONE_HOOK $hook"
            unset hook_path build_hook
        done
    fi
}

cmd_exists() {
    command -v "$1" >/dev/null 2>&1 || msg_error "command '$1' is not available."
}

add_compression() {
    complevel_gzip="${complevel_gzip:--9}"
    complevel_xz="${complevel_xz:--9}"
    complevel_zstd="${complevel_zstd:--19}"
    complevel_lz4="${complevel_lz4:--12}"

    case "$INIT_FS_COMP" in
        xz)
            cmd_exists xz
            comp="xz -C crc32 -T0 $complevel_xz"
        ;;

        zstd)
            cmd_exists zstd
            comp="zstd -T0 $complevel_zstd"
        ;;

        lz4)
            cmd_exists lz4
            comp="lz4 --favor-decSpeed -lz $complevel_lz4"
        ;;

        none) comp="cat" ;;
        *) comp="gzip $complevel_gzip" ;;
    esac
}

cleanup() {
    rm -fr "$INITDIR"
}

interrupted() {
    cleanup
    exit 1
}

usage() {
    cat <<EOF
Usage:
    ${0##*/} [option] [argument]

Options:
    -k <version>      custom kernel version (default: ${KERNEL})
    -o <output>       custom output name (default: ${INITRAMFS})
    -i <init>         custom init file (default: ${INIT_IN})
    -m <modules>      add extra modules (comma separated)
    -b <binaries>     add extra binary (comma separated)
    -f <file>         add extra file (comma separated & absolute path)
    -c <config>       use custom config (default: ${CONFIG})
    -C <compression>  (gzip | xz | zstd | lz4 | none; default: ${INIT_FS_COMP})
    -A <hook>         add extra hook (comma separated, precedence over -a, -s & HOOKS)
    -a <hook>         add extra hook (comma separated, precedence over -s & after HOOKS)
    -s <hook>         skip hook defined in HOOKS (comma separated)
    -q                quiet mode
    -h                print this help msg
EOF
}

need_arg() {
    if [ -z "$1" ]; then
        msg_error 'argument is needed for this option!'
        exit 1
    fi
}

parse_opt() {
    while [ "$1" ]; do
        case $1 in
            -k)
                need_arg "$2"
                KERNEL="$2"

                shift
            ;;

            -o)
                need_arg "$2"
                OUTPUT="$2"

                shift
            ;;

            -i)
                need_arg "$2"
                INIT_IN="$2"

                shift
            ;;

            -c)
                need_arg "$2"
                CONFIG="$2"

                shift
            ;;

            -C)
                need_arg "$2"
                INIT_FS_COMP="$2"

                shift
            ;;

            -A)
                need_arg "$2"
                ADD_EARLY_HOOKS=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -a)
                need_arg "$2"
                ADD_HOOKS=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -s)
                need_arg "$2"
                SKIP_HOOKS=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -m)
                need_arg "$2"
                ADD_MODULES=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -b)
                need_arg "$2"
                ADD_BINARIES=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -f)
                need_arg "$2"
                ADD_FILES=$(printf '%s\n' "$2" | tr ',' ' ')

                shift
            ;;

            -q) QUIET=1 ;;

            -h)
                usage
                exit 0
            ;;

            *)
                msg_error "invalid option '$1'"
                exit 1
            ;;
        esac

        shift
    done
}

main() {
    parse_opt "$@"

    if [ "$(id -u)" -ne 0 ]; then
        msg_error "need root access!"
        exit 1
    fi

    CPIO=$(command -v bsdcpio || command -v cpio)

    if [ -z "$CPIO" ]; then
        msg_error "neither 'bsdcpio' or 'cpio' found, exiting..."
        exit 1
    fi

    [ -f "$CONFIG" ] || {
        msg_error "config file '$CONFIG' does not exist."
        exit 1
    }

    # shellcheck source=@SYSCONFDIR@/mkinitramfs.conf
    . "$CONFIG"

    [ -d "/usr/lib/modules/$KERNEL" ] || {
        msg_error "kernel directory '/usr/lib/modules/$KERNEL' does not exist."
        exit 1
    }

    [ -f "$INIT_IN" ] || {
        msg_error "init file '$INIT_IN' does not exist."
        exit 1
    }

    if [ -n "$OUTPUT" ]; then
        if [ "${OUTPUT##*/}" != "$OUTPUT" ] && [ ! -d "$(dirname "$OUTPUT")" ]; then
            msg_error "directory '$(dirname "$OUTPUT")' for output '${OUTPUT##*/}' does not exist."
            exit 1
        fi

        if [ -d "$OUTPUT" ]; then
            msg_error "'$OUTPUT' is a directory."
            exit 1
        fi

        INITRAMFS="$OUTPUT"
    fi

    # filter out skip hooks (-s)
    if [ -n "$SKIP_HOOKS" ] && [ -n "$HOOKS" ]; then
        for h in $HOOKS; do
            printf '%s\n' "$SKIP_HOOKS" | tr ' ' '\n' | grep -qx "$h" || NEWHOOKS="$NEWHOOKS $h"
        done

        HOOKS=$NEWHOOKS
        unset NEWHOOKS
    fi

    [ -z "$ADD_HOOKS" ] || HOOKS="$HOOKS $ADD_HOOKS"
    [ -z "$ADD_EARLY_HOOKS" ] || HOOKS="$HOOKS $ADD_EARLY_HOOKS"
    [ -z "$ADD_MODULES" ] || MODULES="$MODULES $ADD_MODULES"
    [ -z "$ADD_FILES" ] || FILES="$FILES $ADD_FILES"
    [ -z "$ADD_BINARIES" ] || BINARIES="$BINARIES $ADD_BINARIES"

    [ "$QUIET" != 1 ] && printf 'Generating initramfs...\n'

    mkdir -p "$INITDIR/hook" "$INITDIR/newroot"
    install -m755 "$INIT_IN" "$INITDIR/init"

    run_build_hook

    if [ -n "$BINARIES" ]; then
        msg_info "adding extra binaries..."

        for b in $BINARIES; do
            add_binary "$b"
        done
    fi

    if [ -n "$MODULES" ]; then
        msg_info "adding extra modules..."

        for m in $MODULES; do
            add_module "$m"
        done
    fi

    if [ -n "$FILES" ]; then
        msg_info "adding extra files..."

        for f in $FILES; do
            add_file "$f"
        done
    fi

    add_compression
    finalize_modules

    msg_info "generating initramfs image..."
    rm -f "$INITRAMFS"

    (
        cd "$INITDIR" || exit 1
        find . | LANG=C "$CPIO" -o -H newc --quiet | $comp
    ) > "$INITRAMFS"

    cleanup
    [ "$QUIET" != 1 ] && printf 'Done: %s (%s)\n' "$INITRAMFS" "$(du -h "$INITRAMFS" | awk '{print $1;}')"

    exit 0
}

trap interrupted 1 2 3 15

INITDIR="/tmp/mkinitramfs.$$"
KERNEL="$(uname -r)"
INIT_IN="@DATA_DIR@/init.in"
INITRAMFS="initrd-${KERNEL}.img"
CONFIG="@SYSCONFDIR@/mkinitramfs.conf"
HOOKDIRS="@HOOKS_DIR@"

main "$@"
