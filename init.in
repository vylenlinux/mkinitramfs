#!/bin/sh

# shellcheck disable=SC2154

export PATH=/usr/bin

shell() {
    setsid sh -c 'exec sh </dev/tty1 >/dev/tty1 2>&1'
}

problem() {
    printf "problem occurs, here's a shell.\n"
    shell
}

msg_info() {
    [ "$verbose" = "y" ] || return
    printf ":: %s\n" "$1"
}

mount_setup() {
    mount -t proc proc /proc -o nosuid,noexec,nodev
    mount -t sysfs sys /sys -o nosuid,noexec,nodev
    mount -t devtmpfs dev /dev -o mode=0755,nosuid
    mount -t tmpfs run /run -o nosuid,nodev,mode=0755
}

move_mount_setup() {
    mount --move /proc /newroot/proc
    mount --move /sys /newroot/sys
    mount --move /dev /newroot/dev
    mount --move /run /newroot/run
}

parse_cmdline() {
    read -r cmdline < /proc/cmdline

    for param in $cmdline; do
        case "${param}" in
            *=*)
                key="${param%%=*}"
                value="${param#*=}"
            ;;

            '#'*) break ;;
            *) key="${param}" ;;
        esac

        case "${key}" in
            ro | rw) rwopt="${key}" ;;
            [![:alpha:]_]* | [[:alpha:]_]*[![:alnum:]_]*) ;;
            *) eval "${key}=${value:-y}" ;;
        esac

        unset key value
    done

    case "$root" in
        /dev/*) device="$root" ;;
        UUID=*) device="/dev/disk/by-uuid/${root#UUID=}" ;;
        LABEL=*) device="/dev/disk/by-label/${root#LABEL=}" ;;
    esac
}

mount_root() {
    new_root="$1"

    if [ -z "$device" ]; then
        printf "device not specified!\n"
        shell
    fi

    mount -n ${rootfstype:+-t $rootfstype} -o "${rwopt:-ro}${rootflags:+,$rootflags}" "$device" "$new_root" || {
        printf "cant mount: %s\n" "$device"
        shell
    }
}

run_hook() {
    stage="$1"

    if [ -f /hook/hook.order ]; then
        case "$stage" in
            cleanup)
                sed '1!G;h;$!d' /hook/hook.order > /hook/hook.order_reverse
                mv /hook/hook.order_reverse /hook/hook.order
            ;;
        esac

        while read -r line; do
            # shellcheck source=/hook/$line
            . "/hook/${line}"

            if [ "$(command -v "run_${stage}_hook")" ]; then
                msg_info "running ${stage}_hook: ${line}"
                "run_${stage}_hook"
            fi

            unset -f run_early_hook \
                run_late_hook \
                run_cleanup_hook \
                build_hook
        done < /hook/hook.order
    fi

    unset stage line
}

mount_handler=mount_root
init=/usr/bin/init
rootfstype=auto

mount_setup
parse_cmdline
run_hook early

breakpoint() {
    if [ "$break" = "$1" ] || {
        [ "$2" = "y" ] && [ "$break" = "y" ]
    }; then
        printf "break on %s requested\n" "$1"
        printf "exit this shell to continue booting\n"

        shell
    fi
}

breakpoint premount y

"${mount_handler}" /newroot
run_hook late
run_hook cleanup

breakpoint postmount

move_mount_setup
# shellcheck disable=SC2093
exec switch_root /newroot "$init" "$@"

problem
